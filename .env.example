# Copy to .env and edit. All values stay on your machine.

DB_PATH=./data/nepse_agent.db
COLLECTION_INTERVAL_MINUTES=15
WATCHLIST=NABIL,NICA,HIDCL,NTC,UPPER,NIFRA,SHL

REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=1.5

LOG_LEVEL=INFO
LOG_FILE=./logs/nepse_agent.log

MAX_POSITION_SIZE_PERCENT=5
MAX_DAILY_LOSS_PERCENT=2
PAPER_STARTING_CAPITAL=1000000
